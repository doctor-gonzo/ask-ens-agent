# Copy to .env for a local run against real services; never commit .env.
# PORT=8790
# PUBLIC_URL=http://localhost:8790
# MODEL=fixture                      # a stand-in model; leave unset to use Phala Confidential AI
# CONFIDENTIAL_AI_KEY=
# FACTS_FILE=samples/facts.yaml      # or FACTS_REPO + FACTS_TOKEN (read-only) for the private repo
# FACTS_REPO=doctor-gonzo/ask-ens-agent-data
# FACTS_TOKEN=
# RECLAIM_APP_ID=
# RECLAIM_APP_SECRET=
# RECLAIM_PROVIDER_ID=
# RECLAIM_PROVIDER_VERSION=
